SELECT COUNT(sales_amount) AS count
FROM retail_sales

--sales analysis 

SELECT SUM(sales_amount) AS total_sales
FROM retail_sales

SELECT avg(sales_amount) AS average_sales
FROM retail_sales

SELECT MAX(sales_amount) AS max_sales
FROM retail_sales

SELECT MIN(sales_amount) AS min_sales
FROM retail_sales

SELECT substr(transaction_date, 1, 7) AS year_month , COUNT(transaction_id) as sales_count
FROM retail_sales
GROUP BY substr(transaction_date, 1, 7)
ORDER BY sales_count DESC
limit 5;

SELECT substr(transaction_date, 1, 7) AS year_month , SUM (sales_amount) AS total_profit
FROM retail_sales
GROUP BY substr(transaction_date, 1, 7)
ORDER BY total_profit DESC
limit 5;


--costs analysis--

SELECT SUM(cost) AS total_cost
FROM retail_sales;


SELECT AVG(cost) AS average_cost
FROM retail_sales;



SELECT substr(transaction_date, 1, 7) as year_month, printf('$%,.2f', SUM(cost)) AS total_cost
FROM retail_sales
GROUP BY substr(transaction_date, 1, 7)
ORDER BY total_cost DESC
limit 5;

SELECT substr(transaction_date, 1, 7) as year_month, printf('$%,.2f', SUM(cost)) AS total_cost
FROM retail_sales
GROUP BY substr(transaction_date, 1, 7)
ORDER BY total_cost ASC
limit 5;








