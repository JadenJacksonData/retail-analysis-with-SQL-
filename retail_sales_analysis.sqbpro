SELECT COUNT(sales_amount) AS count

FROM retail_sales



--sales analysis 



SELECT SUM(sales_amount) AS total_sales

FROM retail_sales



SELECT avg(sales_amount) AS average_sales

FROM retail_sales



SELECT MAX(sales_amount) AS max_sales

FROM retail_sales



SELECT MIN(sales_amount) AS min_sales

FROM retail_sales



SELECT substr(transaction_date, 1, 7) AS year_month , COUNT(transaction_id) as sales_count

FROM retail_sales

GROUP BY substr(transaction_date, 1, 7)

ORDER BY sales_count DESC

limit 5;



SELECT substr(transaction_date, 1, 7) AS year_month , SUM (sales_amount) AS total_profit

FROM retail_sales

GROUP BY substr(transaction_date, 1, 7)

ORDER BY total_profit DESC

limit 5;





--costs analysis--



SELECT SUM(cost) AS total_cost

FROM retail_sales;





SELECT AVG(cost) AS average_cost

FROM retail_sales;


SELECT substr(transaction_date, 1, 7) as year_month, SUM(cost) AS total_cost

FROM retail_sales

GROUP BY substr(transaction_date, 1, 7)

ORDER BY total_cost DESC

limit 5;



SELECT substr(transaction_date, 1, 7) as year_month, SUM(cost) AS total_cost

FROM retail_sales

GROUP BY substr(transaction_date, 1, 7)

ORDER BY total_cost ASC

limit 5;

--Product analysis 

SELECT product_name, count(transaction_id) AS total_orders
FROM retail_sales
GROUP BY product_name
ORDER BY total_orders DESC
limit 5;

SELECT product_name, count(transaction_id) AS total_orders
FROM retail_sales
GROUP BY product_name
ORDER BY total_orders ASC
limit 5;


SELECT product_name, SUM(profit) AS total_profit
FROM retail_sales
GROUP BY product_name 
ORDER BY total_profit DESC
limit 5;



SELECT product_name, SUM(profit) AS total_profit
FROM retail_sales
GROUP BY product_name 
ORDER BY total_profit ASC
limit 5;


--Discount Analysis-- 

SELECT 
    product_name,
    SUM(discount) AS total_discount,
    COUNT(*) AS orders,
    AVG(discount) AS avg_discount
FROM retail_sales
GROUP BY product_name
ORDER BY avg_discount DESC
limit 5;


SELECT 
    product_name,
    SUM(discount) AS total_discount,
    COUNT(*) AS orders,
    AVG(discount) AS avg_discount
FROM retail_sales
GROUP BY product_name
ORDER BY avg_discount ASC
limit 5;






---Product Analysis---
	-- Highest order: portable charger (961)
	-- Highest profit: office chair ($123,747.89)
	-- Lowest order: yoga mat (579)
	-- Lowest profit: water bottle ($15740.26)


---Discount Analysis--- 
	-- Average discount per order ranged from approximately $0.069 to $0.081 across products
	-- T-Shirt had the highest average discount per order at approximately $0.081
	-- Desk Lamp had the lowest average discount per order at approximately $0.069
	-- Portable Charger had the highest total discount amount at $73.85
	-- Portable Charger also had the highest order volume at 961 orders
	-- Higher average discounts did not consistently correspond with higher order volume
	-- Discount size alone does not appear to explain differences in product demand
	 


---Data Quality Check---

--12 duplicate ROWS
	-- customer_name has 10 missing values 
	-- found 12 different transaction IDs

---RETAIL SALES ANALYSIS---
	-- COUNT of sales: 20000
	-- total sales: $3081718.11
	-- average sale: $154.09
	-- MAX sale: $1149.95
	-- MIN sale: $18.74
	-- January 2026 had the highest month in sales: 1202
	-- January 2026 had the hgihest months in profits as well: $186914.11
	-- net profit: $1,330,123.61
	-- net profit margin 43.2%
		

---COST ANALYSIS---
